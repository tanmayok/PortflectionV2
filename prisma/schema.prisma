// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid()) @map("_id")
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  subscriptionTier String @default("free") // 'free' | 'premium'
  premium       Boolean   @default(false)
  role          String    @default("user")
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    Int? /// Unix timestamp for ban expiration
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  portfolio     Portfolio[]
}

model Session {
  id             String   @id @default(cuid()) @map("_id")
  userId         String
  token          String
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid()) @map("_id")
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  idToken              String?  // Required for Google OAuth
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid()) @map("_id")
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
model Portfolio {
  id               String   @id @default(cuid()) @map("_id")
  userId           String
  portfolioId      String   @unique @default(cuid())
  publishedUrl     String?  @unique
  isPublished      Boolean  @default(false)
  status           String   @default("draft") // 'draft' | 'published' | 'unpublished'
  version          Int      @default(1)
  portfolioType    String @default("developer")   // e.g. 'developer', 'designer', etc.
  name             String
  title            String
  email            String
  phone            String?
  location         String?
  about            String?
  profileImage     String?
  contactForm      Boolean  @default(true)

  linkedinLink     String?
  personalWebsite  String?

  socials          Json?     // Array of { type: string; url: string; username: string }
  theme            Json?
  layoutType           String         @default("classic") // Options: wavy, minimal, classic
  extraData        Json?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  views            Int      @default(0)

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewsLog         PortfolioView[]
  projects         Project[]
  experiences      Experience[]
  skills           Skill[]
  educations       Education[]

  
  @@index([publishedUrl])
  @@index([userId, status])
}

model Project {
  id            String   @id @default(cuid()) @map("_id")
  userId        String
  portfolioId   String?
  title         String
  description   String
  technologies  String[] // Array of technology names
  images        String[] // Array of image URLs
  liveUrl       String?
  githubUrl     String?
  featured      Boolean  @default(false)
  order         Int      @default(0)
  category      String?  // e.g., "web", "mobile", "desktop"
  status        String   @default("completed") // "completed", "in-progress", "planned"
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio     Portfolio? @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
}

model Experience {
  id            String   @id @default(cuid()) @map("_id")
  userId        String
  portfolioId   String?
  company       String
  position      String
  location      String?
  startDate     DateTime
  endDate       DateTime?
  current       Boolean  @default(false)
  description   String?
  achievements  String[] // Array of achievement descriptions
  skills        String[] // Skills used in this role
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio     Portfolio? @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
}

model Skill {
  id              String   @id @default(cuid()) @map("_id")
  userId          String
  portfolioId     String?
  name            String
  category        String   // e.g., "frontend", "backend", "tools", "soft-skills"
  proficiencyLevel Int     @default(3) // 1-5 scale
  yearsExperience Int?
  certified       Boolean  @default(false)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio       Portfolio? @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
}

model Education {
  id            String   @id @default(cuid()) @map("_id")
  userId        String
  portfolioId   String?
  institution   String
  degree        String
  field         String?
  startDate     DateTime
  endDate       DateTime?
  current       Boolean  @default(false)
  gpa           String?
  description   String?
  achievements  String[] // Array of academic achievements
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio     Portfolio? @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
}

model Template {
  id            String   @id @default(cuid()) @map("_id")
  name          String
  description   String?
  category      String   // e.g., "developer", "designer", "business"
  preview       String?  // Preview image URL
  config        Json     // Template configuration
  isPublic      Boolean  @default(true)
  isPremium     Boolean  @default(false)
  downloads     Int      @default(0)
  rating        Float    @default(0)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  creator       User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
}

model PortfolioView {
  id            String   @id @default(cuid()) @map("_id")
  portfolioId   String
  timestamp     DateTime @default(now())
  ip            String?
  country       String?
  referrer      String?
  userAgent     String?
  isBot         Boolean  @default(false)

  portfolio     Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}
